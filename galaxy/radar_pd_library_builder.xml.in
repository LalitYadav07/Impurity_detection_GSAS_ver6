<tool id="neutrons_radar_pd_library_builder_prototype" name="RADAR-PD Utility: Build CIF Library" profile="22.05" version="0.3.5">
    <description>build a reusable mini or augmented candidate library</description>
    <creator>
        <person name="Lalit Yadav"/>
        <organization url="https://www.ornl.gov/" name="ORNL"/>
    </creator>
    <!-- Deployment template: requires the matching new backend image; no live pin changed. -->
    <requirements>
        <container type="docker" shell="/bin/bash">@IMMUTABLE_BATCH_IMAGE@</container>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        #import shlex
        touch '$library_archive' '$library_manifest' '$console_output' &&
        trap "chmod a+r '$library_archive' '$library_manifest' '$console_output' >/dev/null 2>&1 || true" EXIT &&
        set -euo pipefail &&
        mkdir -p cif_inputs archive_inputs library_output &&
        python -m zipfile -e '$cif_archive' archive_inputs &&
        find archive_inputs -type f -iname '*.cif' -exec cp -n {} cif_inputs/ \; &&
        python /opt/radar-pd/scripts/ndip_runner.py build-library --cif-dir cif_inputs --library-mode '$library_mode' --reviewed-occupancy-excess '$reviewed_occupancy_excess' --occupancy-review-note ${shlex.quote(str($occupancy_review_note))} --radiation '$radiation' --base-db-root "\${RADAR_PD_DB_ROOT}/database_${radiation}" --output-root library_output --manifest-output '$library_manifest' --archive '$library_archive' > >(tee -a '$console_output') 2> >(tee -a '$console_output' >&2)
    ]]></command>
    <inputs>
        <param name="cif_archive" type="data" format="zip" label="Prepared CIF source bundle" help="A ZIP containing one or more CIF files. RADAR-PD Interactive prepares this bundle automatically from loose CIFs, ZIP archives, and reusable Galaxy CIF datasets."/>
        <param name="library_name" type="text" value="custom_candidate_library" label="Scientific library name" help="A short name that will identify this reusable library in Galaxy History and in later RADAR-PD runs.">
            <validator type="regex" message="Use letters, numbers, spaces, periods, underscores, or hyphens (80 characters maximum).">^[A-Za-z0-9][A-Za-z0-9_. -]{0,79}$</validator>
        </param>
        <param name="library_mode" type="select" label="Library type">
            <option value="mini" selected="true">Only my CIFs</option>
            <option value="augmented">Built-in MP/COD catalog + my CIFs</option>
        </param>
        <param name="radiation" type="select" label="Measurement type">
            <option value="neutron" selected="true">Neutron</option>
            <option value="xray">X-ray</option>
        </param>
        <param name="reviewed_occupancy_excess" type="select" label="CIF occupancy policy">
            <option value="0" selected="true">Strict: reject occupancy totals greater than one</option>
            <option value="0.001">Reviewed rounding: preserve original totals up to 1.001</option>
        </param>
        <param name="occupancy_review_note" type="text" value="" optional="true" label="Why the small occupancy excess is acceptable in these source files" help="Required for reviewed rounding. No normalization is performed; negative, nonfinite, malformed and larger excess values are rejected. This does not certify specimen composition.">
            <sanitizer sanitize="false"/>
        </param>
        <param name="overwrite" type="hidden" value=""/>
    </inputs>
    <outputs>
        <data name="library_archive" format="zip" label="RADAR-PD portable custom library | ${library_name}.zip"/>
        <data name="library_manifest" format="json" label="RADAR-PD custom library manifest | ${library_name}.json"/>
        <data name="console_output" format="txt" label="RADAR-PD library build log | ${library_name}.txt"/>
    </outputs>
    <help><![CDATA[
Builds a portable RADAR-PD library from one prepared ZIP bundle. Use RADAR-PD Interactive to combine loose CIF files, one or more ZIP archives, and reusable Galaxy CIF datasets into this bundle. "Only my CIFs" creates a compact standalone library. "Built-in + my CIFs" augments the matching read-only MP/COD catalog. The resulting ZIP is preserved in Galaxy History and can be selected as the candidate library in RADAR-PD Analyze.
    ]]></help>
</tool>
