{
  "$defs": {
    "AxisMapping": {
      "additionalProperties": false,
      "description": "An explicit reviewed sample/run mapping; never inferred from a title.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "measured",
            "nominal_composition",
            "preparation_history",
            "user_supplied"
          ],
          "title": "Kind",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "cycle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "kind"
      ],
      "title": "AxisMapping",
      "type": "object"
    },
    "LatticeSignal": {
      "additionalProperties": false,
      "properties": {
        "phase_key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Phase Key",
          "type": "string"
        },
        "metric": {
          "default": "a",
          "enum": [
            "a",
            "b",
            "c",
            "volume"
          ],
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "phase_key"
      ],
      "title": "LatticeSignal",
      "type": "object"
    },
    "ReferenceCurve": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "temperatures": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Temperatures",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Values",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "source",
        "unit",
        "temperatures",
        "values",
        "source_sha256"
      ],
      "title": "ReferenceCurve",
      "type": "object"
    },
    "ViewSettings": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "phase_evolution",
            "thermal_expansion",
            "distortion",
            "lattice_strain",
            "transition_hysteresis",
            "reaction_progress",
            "operando",
            "sample_composition",
            "broadening",
            "atomic_structure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "default": "",
          "title": "Metric",
          "type": "string"
        },
        "representation": {
          "default": "auto",
          "enum": [
            "auto",
            "absolute",
            "difference",
            "relative",
            "permille",
            "normalized",
            "microstrain",
            "progress"
          ],
          "title": "Representation",
          "type": "string"
        },
        "axis": {
          "default": "shared",
          "enum": [
            "shared",
            "auto",
            "run_number",
            "start_time",
            "elapsed_time",
            "temperature",
            "magnetic_field",
            "pressure",
            "voltage",
            "capacity",
            "sample_state"
          ],
          "title": "Axis",
          "type": "string"
        },
        "phases": {
          "items": {
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "samples": {
          "items": {
            "type": "string"
          },
          "title": "Samples",
          "type": "array"
        },
        "banks": {
          "items": {
            "type": "integer"
          },
          "title": "Banks",
          "type": "array"
        },
        "branch": {
          "default": "all",
          "title": "Branch",
          "type": "string"
        },
        "reference_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Run"
        },
        "connect": {
          "default": false,
          "title": "Connect",
          "type": "boolean"
        },
        "show_uncertainty": {
          "default": true,
          "title": "Show Uncertainty",
          "type": "boolean"
        },
        "x_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Range"
        },
        "y_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Range"
        },
        "include_fixed": {
          "default": false,
          "title": "Include Fixed",
          "type": "boolean"
        },
        "excluded_runs": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Runs",
          "type": "array"
        },
        "hkl": {
          "default": [
            1,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Hkl",
          "type": "array"
        },
        "progress_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress Start"
        },
        "progress_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress End"
        },
        "time_zero": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Zero"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "fit_expansion": {
          "default": false,
          "title": "Fit Expansion",
          "type": "boolean"
        },
        "fit_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Min"
        },
        "fit_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Max"
        },
        "max_temperature_span": {
          "default": 2.0,
          "minimum": 0,
          "title": "Max Temperature Span",
          "type": "number"
        },
        "lattice_series": {
          "items": {
            "$ref": "#/$defs/LatticeSignal"
          },
          "maxItems": 12,
          "title": "Lattice Series",
          "type": "array"
        },
        "ratio_numerator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatticeSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ratio_denominator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatticeSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_curve_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Curve Id"
        },
        "reference_curve_reviewed": {
          "default": false,
          "title": "Reference Curve Reviewed",
          "type": "boolean"
        },
        "reference_output": {
          "default": "overlay",
          "enum": [
            "overlay",
            "residual",
            "temperature",
            "temperature_offset"
          ],
          "title": "Reference Output",
          "type": "string"
        },
        "baseline_temperature_esd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Temperature Esd"
        },
        "temperature_display_unit": {
          "default": "K",
          "enum": [
            "K",
            "C"
          ],
          "title": "Temperature Display Unit",
          "type": "string"
        },
        "show_temperature_span": {
          "default": false,
          "title": "Show Temperature Span",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ViewSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "axis": {
      "default": "auto",
      "enum": [
        "auto",
        "run_number",
        "start_time",
        "elapsed_time",
        "temperature",
        "magnetic_field",
        "pressure",
        "voltage",
        "capacity",
        "sample_state"
      ],
      "title": "Axis",
      "type": "string"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/ViewSettings"
      },
      "maxItems": 30,
      "title": "Views",
      "type": "array"
    },
    "axis_mappings": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/AxisMapping"
        },
        "type": "object"
      },
      "title": "Axis Mappings",
      "type": "object"
    },
    "references": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "References",
      "type": "object"
    },
    "phase_colors": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Phase Colors",
      "type": "object"
    },
    "reference_curves": {
      "additionalProperties": {
        "$ref": "#/$defs/ReferenceCurve"
      },
      "maxProperties": 8,
      "title": "Reference Curves",
      "type": "object"
    }
  },
  "title": "PostAnalysisSettings",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-pd-post-analysis/v1"
}
