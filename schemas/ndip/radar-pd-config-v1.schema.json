{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-pd-config/v1",
  "title": "RADAR-PD portable NDIP configuration",
  "type": "object",
  "required": [
    "$schema",
    "analysis",
    "chemistry",
    "pattern",
    "background",
    "main_phase",
    "full",
    "rapid"
  ],
  "properties": {
    "$schema": {
      "const": "radar-pd-config/v1"
    },
    "scan_interpretation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "min_points": {
          "default": 64,
          "maximum": 10000,
          "minimum": 32,
          "title": "Min Points",
          "type": "integer"
        },
        "peak_error_ratio": {
          "default": 8,
          "maximum": 100,
          "minimum": 3,
          "title": "Peak Error Ratio",
          "type": "number"
        },
        "difference_error_ratio": {
          "default": 6,
          "maximum": 100,
          "minimum": 3,
          "title": "Difference Error Ratio",
          "type": "number"
        },
        "min_peak_fraction": {
          "default": 0.02,
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Min Peak Fraction",
          "type": "number"
        },
        "shape_effect": {
          "default": 0.03,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Shape Effect",
          "type": "number"
        },
        "peak_shift_bins": {
          "default": 0.5,
          "maximum": 10,
          "minimum": 0.2,
          "title": "Peak Shift Bins",
          "type": "number"
        },
        "width_fraction": {
          "default": 0.3,
          "maximum": 3,
          "minimum": 0.1,
          "title": "Width Fraction",
          "type": "number"
        },
        "intensity_fraction": {
          "default": 0.25,
          "maximum": 3,
          "minimum": 0.05,
          "title": "Intensity Fraction",
          "type": "number"
        },
        "scale_fraction": {
          "default": 0.15,
          "maximum": 3,
          "minimum": 0.01,
          "title": "Scale Fraction",
          "type": "number"
        },
        "background_fraction": {
          "default": 0.1,
          "maximum": 2,
          "minimum": 0.01,
          "title": "Background Fraction",
          "type": "number"
        },
        "cell_fraction": {
          "default": 0.0001,
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "title": "Cell Fraction",
          "type": "number"
        },
        "fraction_points": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Fraction Points",
          "type": "number"
        },
        "max_history": {
          "default": 2000,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max History",
          "type": "integer"
        },
        "history_search_limit": {
          "default": 32,
          "maximum": 128,
          "minimum": 2,
          "title": "History Search Limit",
          "type": "integer"
        },
        "condition_tolerances": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Condition Tolerances",
          "type": "object"
        },
        "condition_bindings": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Condition Bindings",
          "type": "object"
        },
        "references": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "References",
          "type": "object"
        },
        "reference_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reference Hashes",
          "type": "object"
        },
        "active_revisions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Active Revisions",
          "type": "object"
        },
        "reviewed_candidate_equivalences": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reviewed Candidate Equivalences",
          "type": "object"
        }
      },
      "title": "InterpretationSettings",
      "type": "object"
    },
    "post_analysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "axis": {
          "default": "auto",
          "enum": [
            "auto",
            "run_number",
            "start_time",
            "elapsed_time",
            "temperature",
            "magnetic_field",
            "pressure",
            "voltage",
            "capacity",
            "sample_state"
          ],
          "title": "Axis",
          "type": "string"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/ViewSettings"
          },
          "maxItems": 30,
          "title": "Views",
          "type": "array"
        },
        "axis_mappings": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/AxisMapping"
            },
            "type": "object"
          },
          "title": "Axis Mappings",
          "type": "object"
        },
        "references": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "References",
          "type": "object"
        },
        "phase_colors": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Phase Colors",
          "type": "object"
        },
        "reference_curves": {
          "additionalProperties": {
            "$ref": "#/$defs/ReferenceCurve"
          },
          "maxProperties": 8,
          "title": "Reference Curves",
          "type": "object"
        }
      },
      "title": "PostAnalysisSettings",
      "type": "object"
    },
    "created_utc": {
      "type": "string"
    },
    "analysis": {
      "type": "object",
      "required": [
        "mode",
        "radiation",
        "instrument_mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rapid",
            "full"
          ]
        },
        "radiation": {
          "enum": [
            "neutron",
            "xray"
          ]
        },
        "instrument_mode": {
          "enum": [
            "auto",
            "cw",
            "tof"
          ]
        }
      }
    },
    "chemistry": {
      "type": "object",
      "required": [
        "sample_elements",
        "environment_elements"
      ],
      "properties": {
        "sample_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]?$"
          }
        },
        "environment_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]?$"
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "properties": {
        "limits": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "exclude_regions": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "reference_phase_exclusions": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "presets": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Al_fcc",
                  "Cu_fcc",
                  "V_bcc"
                ]
              }
            },
            "window_mode": {
              "enum": [
                "auto",
                "fixed"
              ]
            },
            "include_cu_kbeta": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "background": {
      "type": "object"
    },
    "main_phase": {
      "type": "object"
    },
    "magnetic_precheck": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "q_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "denominators": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    "full": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "quick",
            "balanced",
            "thorough",
            "custom"
          ]
        },
        "max_passes": {
          "type": "integer",
          "minimum": 1
        },
        "min_phase_percent": {
          "type": "number",
          "minimum": 0
        },
        "top_n_ml": {
          "type": "integer",
          "minimum": 1
        },
        "nudge_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "cell_length_tolerance_pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cell_angle_tolerance_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nudge_samples": {
          "type": "integer",
          "minimum": 1
        },
        "nudge_representatives": {
          "type": "integer",
          "minimum": 1
        },
        "compare_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "compare_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "final_joint_cell_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "rapid": {
      "type": "object",
      "properties": {
        "phases_per_hypothesis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "stage_output_limit": {
          "type": "integer",
          "minimum": 3,
          "maximum": 50
        },
        "gsas_validation_limit": {
          "type": "integer",
          "minimum": 0
        },
        "parallel_workers": {
          "type": "integer",
          "minimum": 1
        },
        "show_family_variants": {
          "type": "boolean"
        },
        "final_polish_enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "AxisMapping": {
      "additionalProperties": false,
      "description": "An explicit reviewed sample/run mapping; never inferred from a title.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "measured",
            "nominal_composition",
            "preparation_history",
            "user_supplied"
          ],
          "title": "Kind",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "cycle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "kind"
      ],
      "title": "AxisMapping",
      "type": "object"
    },
    "ViewSettings": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "phase_evolution",
            "thermal_expansion",
            "distortion",
            "lattice_strain",
            "transition_hysteresis",
            "reaction_progress",
            "operando",
            "sample_composition",
            "broadening",
            "atomic_structure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metric": {
          "default": "",
          "title": "Metric",
          "type": "string"
        },
        "representation": {
          "default": "auto",
          "enum": [
            "auto",
            "absolute",
            "difference",
            "relative",
            "permille",
            "normalized",
            "microstrain",
            "progress"
          ],
          "title": "Representation",
          "type": "string"
        },
        "axis": {
          "default": "shared",
          "enum": [
            "shared",
            "auto",
            "run_number",
            "start_time",
            "elapsed_time",
            "temperature",
            "magnetic_field",
            "pressure",
            "voltage",
            "capacity",
            "sample_state"
          ],
          "title": "Axis",
          "type": "string"
        },
        "phases": {
          "items": {
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "samples": {
          "items": {
            "type": "string"
          },
          "title": "Samples",
          "type": "array"
        },
        "banks": {
          "items": {
            "type": "integer"
          },
          "title": "Banks",
          "type": "array"
        },
        "branch": {
          "default": "all",
          "title": "Branch",
          "type": "string"
        },
        "reference_run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Run"
        },
        "connect": {
          "default": false,
          "title": "Connect",
          "type": "boolean"
        },
        "show_uncertainty": {
          "default": true,
          "title": "Show Uncertainty",
          "type": "boolean"
        },
        "x_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Range"
        },
        "y_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Range"
        },
        "include_fixed": {
          "default": false,
          "title": "Include Fixed",
          "type": "boolean"
        },
        "excluded_runs": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Runs",
          "type": "array"
        },
        "hkl": {
          "default": [
            1,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Hkl",
          "type": "array"
        },
        "progress_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress Start"
        },
        "progress_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress End"
        },
        "time_zero": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Zero"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "fit_expansion": {
          "default": false,
          "title": "Fit Expansion",
          "type": "boolean"
        },
        "fit_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Min"
        },
        "fit_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Max"
        },
        "max_temperature_span": {
          "default": 2.0,
          "minimum": 0,
          "title": "Max Temperature Span",
          "type": "number"
        },
        "lattice_series": {
          "items": {
            "$ref": "#/$defs/LatticeSignal"
          },
          "maxItems": 12,
          "title": "Lattice Series",
          "type": "array"
        },
        "ratio_numerator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatticeSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ratio_denominator": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatticeSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_curve_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Curve Id"
        },
        "reference_curve_reviewed": {
          "default": false,
          "title": "Reference Curve Reviewed",
          "type": "boolean"
        },
        "reference_output": {
          "default": "overlay",
          "enum": [
            "overlay",
            "residual",
            "temperature",
            "temperature_offset"
          ],
          "title": "Reference Output",
          "type": "string"
        },
        "baseline_temperature_esd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Temperature Esd"
        },
        "temperature_display_unit": {
          "default": "K",
          "enum": [
            "K",
            "C"
          ],
          "title": "Temperature Display Unit",
          "type": "string"
        },
        "show_temperature_span": {
          "default": false,
          "title": "Show Temperature Span",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ViewSettings",
      "type": "object"
    },
    "LatticeSignal": {
      "additionalProperties": false,
      "properties": {
        "phase_key": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Phase Key",
          "type": "string"
        },
        "metric": {
          "default": "a",
          "enum": [
            "a",
            "b",
            "c",
            "volume"
          ],
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "phase_key"
      ],
      "title": "LatticeSignal",
      "type": "object"
    },
    "ReferenceCurve": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "temperatures": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Temperatures",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Values",
          "type": "array"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "source",
        "unit",
        "temperatures",
        "values",
        "source_sha256"
      ],
      "title": "ReferenceCurve",
      "type": "object"
    }
  }
}
