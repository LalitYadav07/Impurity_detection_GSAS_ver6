{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-pd-library/v1",
  "title": "RADAR-PD custom phase-library manifest",
  "type": "object",
  "required": ["$schema", "library_mode", "radiation", "phase_count", "archive_root"],
  "properties": {
    "$schema": {"const": "radar-pd-library/v1"},
    "library_mode": {"enum": ["mini", "augmented"]},
    "radiation": {"enum": ["neutron", "xray"]},
    "phase_count": {"type": "integer", "minimum": 1},
    "archive_root": {"type": "string"},
    "database_config": {"type": "object"},
    "phase_ids": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array"},
    "occupancy_reviews": {
      "description": "Unverified per-source declarations, recomputed by the native runner only after explicit configuration activation.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["schema", "source_sha256", "canonical_sha256", "policy_sha256", "maximum_site_excess", "affected_sites", "composition", "normalization_applied"],
        "properties": {
          "schema": {"const": "radar-cif-occupancy-review/v1"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "canonical_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "maximum_site_excess": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001},
          "affected_sites": {"type": "array", "minItems": 1},
          "composition": {"type": "object"},
          "normalization_applied": {"const": false}
        }
      }
    }
  }
}
