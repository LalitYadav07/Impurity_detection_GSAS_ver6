# Synthetic SG 113 regression geometry, constructed for software tests.
# Arbitrary cell and exact fractional coordinates; not a measured or published
# structure, not a refined specimen, and not an experimental Er2Be2GeO7 model.
# See README.md for construction and the separate structural-fixture sources.
data_synthetic_sg113_regression

_pd_phase_name  'Synthetic SG113 Er-Be-Ge-O fixture'
_chemical_name_common  'Synthetic magnetic planner regression fixture'
_cell_length_a  8.0
_cell_length_b  8.0
_cell_length_c  5.4
_cell_angle_alpha  90.0000
_cell_angle_beta  90.0000
_cell_angle_gamma  90.0000
_cell_volume  345.6
_symmetry_cell_setting  tetragonal
_symmetry_space_group_name_H-M  "P -4 21 m"
loop_
    _space_group_symop_id
    _space_group_symop_operation_xyz
     1  x,y,z
     2  y,-x,-z
     3  -x,-y,z
     4  -y,x,-z
     5  1/2-x,1/2+y,-z
     6  1/2+y,1/2+x,z
     7  1/2+x,1/2-y,-z
     8  1/2-y,1/2-x,z

