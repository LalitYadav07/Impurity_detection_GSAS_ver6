pid /tmp/radar-pd-nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    client_body_temp_path /tmp/radar-pd-nginx/client-body;
    proxy_temp_path /tmp/radar-pd-nginx/proxy;
    fastcgi_temp_path /tmp/radar-pd-nginx/fastcgi;
    uwsgi_temp_path /tmp/radar-pd-nginx/uwsgi;
    scgi_temp_path /tmp/radar-pd-nginx/scgi;

    server {
        listen 8081;
        server_name _;
        absolute_redirect off;
        client_max_body_size 2g;

        location = ${EP_PATH} {
            return 308 ${EP_PATH}/$is_args$args;
        }

        location ^~ ${EP_PATH}/ {
            rewrite ^${EP_PATH}/?(.*)$ /$1 break;
            proxy_pass http://127.0.0.1:8080;
            proxy_intercept_errors on;
            error_page 502 503 504 =200 @radar_pd_starting;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_intercept_errors on;
            error_page 502 503 504 =200 @radar_pd_starting;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400;
        }

        location @radar_pd_starting {
            default_type text/html;
            add_header Cache-Control "no-store" always;
            add_header Retry-After "2" always;
            return 200 '<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="refresh" content="2"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RADAR-PD starting</title><style>body{font-family:system-ui,sans-serif;margin:0;background:#f7faf8;color:#153e32;display:grid;min-height:100vh;place-items:center}.status{max-width:34rem;padding:2rem;border:1px solid #bdd4c8;background:#fff;border-radius:8px}h1{font-size:1.35rem;margin:0 0 .75rem}p{margin:0;color:#50675f}</style></head><body><div class="status"><h1>RADAR-PD is starting</h1><p>The scientific workspace is loading. This page will refresh automatically.</p></div></body></html>';
        }
    }
}
