# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual / environment directories
/.pixi/envs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# Data / databases / run outputs
/runs/
/Results/
/Diagnostics/
/Technical/
/data/
/data_old/
/database_xray.zip
/.ndip_catalog/
/data/database_xray/
/data/database_neutron/
 
# Keep most ad-hoc documentation artifacts out of commits, but allow the
# maintained hosted user manual package.
/docs/*
!/docs/radar_api.md
!/docs/VALIDATION_CHECKLIST.md
!/docs/ndip_container.md
!/docs/ndip_integration.md
!/docs/user_manual/
!/docs/user_manual/**
/docs/user_manual/dist/*
!/docs/user_manual/dist/.gitkeep
/docs/user_manual/examples/*
!/docs/user_manual/examples/.gitkeep

# GSAS-II build / vendored compiled artifacts
/GSAS-II/
/GSAS-II/build/
/GSAS-II/pixi/
GSAS-II/*.egg-info

# Machine-learning artifacts (large model weights)
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.npz.*
!ML_components/*.pt
!ML_ranker/*.pt
!ML_ranker/**/mlp_ranker.pt

# IDE / Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.cache

# Archives and large generated files
*.zip
*.tar.gz
*.tar
*.gz

# Python test / cache
.pytest_cache/
.pytest_tmp*/
test_tmp_manual/

# Misc
*.bak
*.old

# Keep repo metadata files and configuration tracked
!.github/
!.streamlit/
!README.md
LICENSE
pyproject.toml
requirements.txt
pixi.toml
pixi.lock
