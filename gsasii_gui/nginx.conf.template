pid /tmp/gsasii-nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path /tmp/gsasii-nginx/client-body;
    proxy_temp_path /tmp/gsasii-nginx/proxy;
    fastcgi_temp_path /tmp/gsasii-nginx/fastcgi;
    uwsgi_temp_path /tmp/gsasii-nginx/uwsgi;
    scgi_temp_path /tmp/gsasii-nginx/scgi;

    server {
        listen 8080;
        server_name _;
        server_tokens off;
        absolute_redirect off;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;

        location = ${EP_PATH} {
            return 302 ${EP_PATH}/vnc.html?autoconnect=1&resize=scale&reconnect=1&quality=6&compression=1&path=${EP_WS_PATH}/websockify;
        }

        location = ${EP_PATH}/ {
            return 302 ${EP_PATH}/vnc.html?autoconnect=1&resize=scale&reconnect=1&quality=6&compression=1&path=${EP_WS_PATH}/websockify;
        }

        location = ${EP_PATH}/healthz {
            default_type application/json;
            return 200 '{"status":"ok","version":"${GUI_VERSION}"}\n';
        }

        location = ${EP_PATH}/websockify {
            proxy_pass http://127.0.0.1:6080;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_socket_keepalive on;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        location ${EP_PATH}/ {
            alias /opt/noVNC/;
            sub_filter '<title>noVNC</title>' '<title>RADAR-PD GSAS-II ${GUI_VERSION}</title>';
            sub_filter_once on;
        }
    }
}
