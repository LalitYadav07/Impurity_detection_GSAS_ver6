ARG RADAR_PD_BASE_IMAGE=savannah.ornl.gov/radar-pd/radar-pd:ndip-space-groups-20260825
FROM ${RADAR_PD_BASE_IMAGE}

USER root

# Keep the validated scientific environment and catalog unchanged while
# updating presentation output and NDIP database-pack path resolution.
COPY --chown=radar:radar scripts/ndip_runner.py /opt/radar-pd/scripts/ndip_runner.py
COPY --chown=radar:radar scripts/gsas_complete_pipeline_nomain.py /opt/radar-pd/scripts/gsas_complete_pipeline_nomain.py
COPY --chown=radar:radar scripts/gsas_main_phase_refiner.py /opt/radar-pd/scripts/gsas_main_phase_refiner.py
COPY --chown=radar:radar scripts/plotly_interactive.py /opt/radar-pd/scripts/plotly_interactive.py
RUN python -m py_compile \
        /opt/radar-pd/scripts/ndip_runner.py \
        /opt/radar-pd/scripts/gsas_complete_pipeline_nomain.py \
        /opt/radar-pd/scripts/gsas_main_phase_refiner.py \
        /opt/radar-pd/scripts/plotly_interactive.py

USER radar
