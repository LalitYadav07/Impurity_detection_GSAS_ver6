# Preserve the scientific runtime that reproduced the complete 141-scan study.
# Dependency upgrades require their own real-pattern validation. Copying tested
# application source must not resolve a newer GSAS-II or numerical stack.
FROM ghcr.io/lalityadav07/impurity_detection_gsas_ver6:ndip-ac3bf6ff93d163c7a58d07322fcb1d5e44961215@sha256:6c19f717e9a644252553a008babc2b86e7258bd9a45992d4d28504f2bfada8d4

USER root
WORKDIR /opt/radar-pd
ARG RADAR_PD_BUILD_SHA=unknown
ENV RADAR_PD_GIT_COMMIT=${RADAR_PD_BUILD_SHA}
COPY --chown=radar:radar . /opt/radar-pd
RUN python -m py_compile \
        scripts/ndip_contracts.py \
        scripts/ndip_gpx_handoff.py \
        scripts/ndip_ipts_watch.py \
        scripts/ndip_input_provenance.py \
        scripts/ndip_acquisition.py \
        scripts/ndip_outputs.py \
        scripts/ndip_lattice.py \
        scripts/ndip_observables.py \
        scripts/ndip_pattern_observation.py \
        scripts/gsas_cif_import.py \
        scripts/gsas_signed_fxye.py \
        scripts/gsas_core_infrastructure.py \
        scripts/ndip_refinement.py \
        scripts/ndip_runner.py

ENV PYTHONPATH=/opt/radar-pd/scripts:/opt/radar-pd/GSAS-II

VOLUME ["/work", "/opt/radar-pd/data"]
CMD ["python", "/opt/radar-pd/scripts/ndip_runner.py", "--help"]
