# Copy only the existing immutable built-in data; keep its older runtime out
# of the scientific image. This registry permits anonymous read access.
FROM savannah.ornl.gov/radar-pd/radar-pd@sha256:eeb2c0c6f2892f22b655ed39cf70ef9ddd508dab012deb2c771d7e8091ba121a AS builtin_catalog

# Preserve the scientific runtime that reproduced the complete 141-scan study.
# Dependency upgrades require their own real-pattern validation. Copying tested
# application source must not resolve a newer GSAS-II or numerical stack.
FROM ghcr.io/lalityadav07/impurity_detection_gsas_ver6:ndip-ac3bf6ff93d163c7a58d07322fcb1d5e44961215@sha256:6c19f717e9a644252553a008babc2b86e7258bd9a45992d4d28504f2bfada8d4

USER root
# COPY cannot remove files inherited from the pinned runtime image.
RUN rm -rf /opt/radar-pd/nova/tests /opt/radar-pd/tests /opt/radar-symmetry/tests /src/tests
WORKDIR /opt/radar-pd
ARG RADAR_PD_BUILD_SHA=unknown
ENV RADAR_PD_GIT_COMMIT=${RADAR_PD_BUILD_SHA}
ENV RADAR_PD_EXECUTION_CONTEXT=galaxy
COPY --chown=radar:radar . /opt/radar-pd
# The inherited /opt/radar-pd/data is a VOLUME. Keep required immutable assets
# outside that mount so an empty runtime volume cannot hide the catalog.
COPY --from=builtin_catalog --chown=radar:radar /opt/radar-pd/data/ /opt/radar-pd/catalog/
ENV RADAR_PD_DB_ROOT=/opt/radar-pd/catalog \
    RADAR_PD_DATABASE_VERSION=orc-builtins-20260617
LABEL gov.ornl.radar-pd.catalog.version="orc-builtins-20260617" \
    gov.ornl.radar-pd.catalog.source="savannah.ornl.gov/radar-pd/radar-pd@sha256:eeb2c0c6f2892f22b655ed39cf70ef9ddd508dab012deb2c771d7e8091ba121a"
RUN python scripts/ndip_catalog_bundle.py prepare-runtime-layout --source /opt/radar-pd/catalog \
    && python scripts/ndip_catalog_bundle.py verify-installed --source /opt/radar-pd/catalog
RUN python -m py_compile \
        scripts/ndip_contracts.py \
        scripts/ndip_gpx_handoff.py \
        scripts/ndip_ipts_watch.py \
        scripts/ndip_input_provenance.py \
        scripts/ndip_acquisition.py \
        scripts/ndip_outputs.py \
        scripts/ndip_lattice.py \
        scripts/ndip_observables.py \
        scripts/ndip_pattern_observation.py \
        scripts/gsas_cif_import.py \
        scripts/gsas_signed_fxye.py \
        scripts/gsas_core_infrastructure.py \
        scripts/gsas_native_observations.py \
        scripts/ndip_refinement.py \
        scripts/ndip_runner.py \
    && python -m compileall -q nova/src/gpx_recipe

ENV PYTHONPATH=/opt/radar-pd/nova/src:/opt/radar-pd/scripts:/opt/radar-pd/GSAS-II

# The recipe worker and model worker use one reviewed native powder kernel.
# Apply once at image build; existing containers and sealed results are intact.
RUN mkdir -p /opt/radar-native/gpx_recipe/live \
    && python -m gpx_recipe.live.native_peak_batch --build \
    && python tests/gpx_recipe/kernel_geometry_control.py \
        --kernel-patch nova/src/gpx_recipe/symmetry/kernel_patch.py \
        > /opt/radar-pd/kernel-geometry-validation.log \
    && python tests/gpx_recipe/nuclear_powder_control.py \
        > /opt/radar-pd/nuclear-powder-validation.log \
    && python -m gpx_recipe.symmetry.kernel_patch --apply \
        > /opt/radar-pd/kernel-patch-provenance.json \
    && python -m gpx_recipe.symmetry.space_group_patch --apply \
        > /opt/radar-pd/periodic-site-patch-provenance.json

VOLUME ["/work", "/opt/radar-pd/data"]
CMD ["python", "/opt/radar-pd/scripts/ndip_runner.py", "--help"]
